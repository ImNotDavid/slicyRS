# --- how users reach the server ------------------------------------------------------------
# Choose ONE of the two options below, and make PUBLIC_URL match what users type in the browser.
#
# A) A DNS name that points at this machine (campus or public). Caddy gets a real certificate automatically.
#    Ports 80 and 443 must be reachable from the internet for the certificate check.
#      SITE_ADDRESS=slicer.example.ac.uk
#      CADDYFILE=Caddyfile
#      PUBLIC_URL=https://slicer.example.ac.uk
#
# B) Internal only: a LAN name or an IP address, with a certificate from Caddy's own authority.
#    Each user's device must trust that authority once (deploy/DEPLOY.md, "Trusting the internal certificate").
#      SITE_ADDRESS=192.168.1.50
#      CADDYFILE=Caddyfile.internal
#      PUBLIC_URL=https://192.168.1.50
SITE_ADDRESS=slicer.example.ac.uk
CADDYFILE=Caddyfile
PUBLIC_URL=https://slicer.example.ac.uk

# --- secrets (deploy/install.sh generates this for you)
# Changing this later makes stored printer access codes unreadable (re-enter them in Admin).
SECRET_KEY=

# --- Sign-in option A: emailed one-time codes (needs no approval from anyone) ---------------
# Any SMTP service works: your own mail account's SMTP + app password, or a transactional provider
# (Postmark, Resend, Amazon SES, Mailgun...). Use a verified sender address on a domain you control
# (SPF/DKIM set up) or the codes will land in spam. Test it in Admin > Users > "Send myself a test email".
# Brevo: Brevo dashboard > SMTP & API > SMTP. The login is shown there (it is NOT your Brevo password) and the
# password is an SMTP key you generate on that page. SMTP_FROM must be a sender/domain verified in Brevo
# (Senders, Domains & Dedicated IPs), otherwise Brevo rejects the message. Free plan: 300 emails per day.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your-brevo-smtp-login
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=slicyRS <verified-sender@your-domain>
CODE_TTL_MIN=10

# --- Sign-in option B: Imperial College SSO (Microsoft Entra ID, OpenID Connect) ----------
# Needs an app registration from Imperial ICT (see deploy/ENTRA_SETUP.md). Leave blank to use email codes only.
# Register an app in Entra (ask Imperial ICT), redirect URI: https://<DOMAIN>/auth/callback
OIDC_ISSUER=
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
SSO_NAME=Imperial College London

# --- who may sign in ---------------------------------------------------------
# These addresses become admins on their first SSO sign-in; everyone else must be invited in the Admin console.
ADMIN_EMAILS=you@imperial.ac.uk
ALLOWED_EMAIL_DOMAINS=imperial.ac.uk,ic.ac.uk

# --- slicing engine (paths inside the image) -------------------------------
SLICER_MODE=orca
SEED_DEMO=0
DEV_AUTH=0
